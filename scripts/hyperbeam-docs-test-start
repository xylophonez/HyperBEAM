    [
        maps:from_list([
            {Device, Spec}
        || {Device, Spec, _Impl} <- DeviceSpecs
        ])
        | hb_opts:get(<<"name-resolvers">>, [], Base)
    ],
TrustedDevices =
    maps:merge(
        hb_opts:get(<<"trusted-devices">>, #{}, Base),
        maps:from_list([
            {Spec, Impl}
        || {_Device, Spec, Impl} <- DeviceSpecs
        ])
    ),
TrustedSigners =
    [
        #{
            <<"address">> => KaySigner,
            <<"devices">> =>
                lists:flatmap(
                    fun({Device, Spec, _Impl}) -> [Device, Spec] end,
                    DeviceSpecs
                )
        }
